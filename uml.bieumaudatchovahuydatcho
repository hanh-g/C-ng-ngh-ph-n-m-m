@startuml
title Nhóm 3 - Đặt chỗ & Hủy đặt chỗ
left to right direction

actor "Khách hàng" as KH
actor "Restaurant API" as RAPI
actor "SMS Gateway" as SMS

rectangle "Biểu mẫu Đặt chỗ & Hủy đặt chỗ" {
    usecase "UC07\nXem lịch sử đặt bàn" as UC07
    usecase "UC08\nHủy đặt chỗ" as UC08
    usecase "UC10\nKích hoạt phiên\ngiữ chỗ 5 phút" as UC10
    usecase "UC12\nĐiền và gửi\nForm đặt chỗ" as UC12
    usecase "UC21\nĐồng bộ trạng thái\nđơn hủy qua API" as UC21
    usecase "UC22\nPhát tin nhắn OTP\nvà thông báo SMS" as UC22
}

KH --> UC07
KH --> UC08
KH --> UC12

RAPI --> UC12
RAPI --> UC21
SMS --> UC22

UC08 ..> UC07 : <<extend>>
